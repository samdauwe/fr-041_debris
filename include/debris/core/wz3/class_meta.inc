WZ3_API const wz3_class_info *wz3_class_lookup(uint16_t id)
{
  size_t lo = 0, hi = sizeof wz3__class_table / sizeof wz3__class_table[0];
  while (lo < hi) {
    const size_t mid = lo + (hi - lo) / 2;
    if (wz3__class_table[mid].id == id) return &wz3__class_table[mid];
    if (wz3__class_table[mid].id < id) lo = mid + 1;
    else hi = mid;
  }
  return NULL;
}

