# debris_embed_licenses(<output header> <title> <file> [<title> <file> ...])
#
# Writes a C header with `static const plicense player_licenses[]` holding the text of every file, so that the player carries the notices of
# the sources it is built from (debris --licenses). The configure step reruns when one of the files changes.
function(debris_embed_licenses output)
  set(body "/* generated by EmbedLicenses.cmake: do not edit */\nstatic const plicense player_licenses[] = {\n")
  set(count 0)
  list(LENGTH ARGN n_args)
  math(EXPR last "${n_args} - 1")
  foreach(i RANGE 0 ${last} 2)
    list(GET ARGN ${i} title)
    math(EXPR j "${i} + 1")
    list(GET ARGN ${j} path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" text)
    # C string literal: escape \ and ", one literal per line (also keeps every literal far below the 64 KiB limit of some compilers)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    string(REPLACE "?" "\\?" text "${text}")
    string(REPLACE "\n" "\\n\"\n    \"" text "${text}")
    string(APPEND body "  {\"${title}\",\n    \"${text}\"},\n")
    math(EXPR count "${count} + 1")
  endforeach()
  string(APPEND body "};\nstatic const size_t player_n_licenses = ${count};\n")
  # rewrite only on change, so that an unchanged notice does not rebuild the player
  set(old "")
  if(EXISTS "${output}")
    file(READ "${output}" old)
  endif()
  if(NOT old STREQUAL body)
    file(WRITE "${output}" "${body}")
  endif()
endfunction()
