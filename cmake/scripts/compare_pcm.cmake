# Render a song with the C99 port and with the C++ v2redux oracle and require
# identical output files.
foreach(v V2_RENDER ORACLE SONG FRAMES NAME WORK)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "compare_pcm.cmake: ${v} is not set")
  endif()
endforeach()

set(out_c "${WORK}/${NAME}.c.f32")
set(out_o "${WORK}/${NAME}.oracle.f32")
set(extra)
if(NOT "${MASK}" STREQUAL "")
  set(extra "${MASK}")
endif()

execute_process(COMMAND ${V2_RENDER} "${SONG}" "${out_c}" ${FRAMES} ${extra} RESULT_VARIABLE rc ERROR_VARIABLE err)
if(rc)
  message(FATAL_ERROR "v2_render failed (${rc}): ${err}")
endif()
execute_process(COMMAND ${ORACLE} "${SONG}" "${out_o}" ${FRAMES} ${extra} RESULT_VARIABLE rc ERROR_VARIABLE err)
if(rc)
  message(FATAL_ERROR "oracle failed (${rc}): ${err}")
endif()

execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${out_c}" "${out_o}" RESULT_VARIABLE rc)
file(SIZE "${out_c}" size_c)
file(REMOVE "${out_c}" "${out_o}")
if(rc)
  message(FATAL_ERROR "${NAME}: PCM differs from the v2redux oracle")
endif()
math(EXPR expect "${FRAMES} * 8")
if(NOT size_c EQUAL expect)
  message(FATAL_ERROR "${NAME}: unexpected output size ${size_c} (expected ${expect})")
endif()
message(STATUS "${NAME}: ${FRAMES} frames identical to the oracle")
