# Runs the native player over the times of a golden set and compares its pictures with the Chrome pictures.
#
#   cmake -DDEBRIS=<exe> -DNODE=<node> -DCOMPARE=<tools/compare_goldens.mjs> -DGOLDENS=<dir with frame_*.png> -DOUT=<work dir>
#         -DSIZE=WxH -DTEXTURE=<-3..0> [-DMEAN=.. -DGROSS=.. -DBLOCK=..] -P run_goldens.cmake
#
# The times come from the names of the golden pictures (frame_<milliseconds>.png), so a new golden needs no change here. Prints
# "SKIP: ..." (the test treats that as skipped) when the player cannot create an OpenGL ES context.
file(GLOB pictures RELATIVE "${GOLDENS}" "${GOLDENS}/frame_*.png")
list(SORT pictures)
if(NOT pictures)
  message(FATAL_ERROR "no frame_*.png in ${GOLDENS}")
endif()
set(times "")
foreach(name IN LISTS pictures)
  string(REGEX REPLACE "^frame_0*([0-9]+)\\.png$" "\\1" ms "${name}")
  math(EXPR seconds "${ms} / 1000")
  math(EXPR back "${seconds} * 1000")
  if(NOT back EQUAL ms)
    message(FATAL_ERROR "${name}: golden times are whole seconds")
  endif()
  list(APPEND times ${seconds})
endforeach()
list(JOIN times "," time_list)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_VIDEODRIVER} offscreen)
set(ENV{SDL_AUDIODRIVER} dummy)
if(DEFINED LSAN_OPTIONS)
  set(ENV{LSAN_OPTIONS} "${LSAN_OPTIONS}")
endif()
execute_process(COMMAND "${DEBRIS}" --times ${time_list} --screenshot-dir "${OUT}" --size ${SIZE} --texture-quality ${TEXTURE}
                RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  if("${errors}" MATCHES "OpenGL context|window:")
    message("SKIP: no OpenGL ES context (${errors})")
    return()
  endif()
  message(FATAL_ERROR "debris failed (${status}): ${errors}")
endif()
if(NOT DEFINED MEAN)
  set(MEAN 3.0)
endif()
if(NOT DEFINED GROSS)
  set(GROSS 0.02)
endif()
if(NOT DEFINED BLOCK)
  set(BLOCK 60)
endif()
execute_process(COMMAND "${NODE}" "${COMPARE}" --chrome "${GOLDENS}" --native "${OUT}" --mean ${MEAN} --gross ${GROSS} --block ${BLOCK} --diffs "${OUT}/diffs" --quiet
                RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors)
message("${report}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "the pictures of the player differ from Chrome's (difference images in ${OUT}/diffs): ${errors}")
endif()
# the control: the same limits must reject every wrong pairing (each Chrome picture against the native picture of the next time)
execute_process(COMMAND "${NODE}" "${COMPARE}" --chrome "${GOLDENS}" --native "${OUT}" --mean ${MEAN} --gross ${GROSS} --block ${BLOCK} --control --quiet
                RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors)
message("${report}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "the control passed a wrong pairing: the limits cannot tell a wrong picture from a right one: ${errors}")
endif()
