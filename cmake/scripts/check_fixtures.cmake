# Reports drift between the fixtures of this repository and the ones the reference repository generates from the JavaScript port.
#   -DOURS=<tests/data> -DREFERENCE=<native/tests/wz3/fixtures of the reference checkout>
if(NOT IS_DIRECTORY "${REFERENCE}")
  message("SKIP: ${REFERENCE} does not exist")
  return()
endif()
file(GLOB names RELATIVE "${REFERENCE}" "${REFERENCE}/*.txt")
set(bad "")
foreach(name IN LISTS names)
  if(NOT EXISTS "${OURS}/${name}")
    list(APPEND bad "${name}: missing here")
    continue()
  endif()
  file(SHA256 "${OURS}/${name}" a)
  file(SHA256 "${REFERENCE}/${name}" b)
  if(NOT a STREQUAL b)
    list(APPEND bad "${name}: differs")
  endif()
endforeach()
if(bad)
  string(REPLACE ";" "\n" report "${bad}")
  message(FATAL_ERROR "tests/data has drifted from the reference fixtures:\n${report}")
endif()
list(LENGTH names count)
message(STATUS "${count} fixtures identical to the reference")
